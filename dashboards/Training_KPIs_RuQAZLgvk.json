          "afterRender": "",
          "content": "<div id=\"hr-training-metrics-panel\"\n  style=\"background-color:transparent;color:#f8fafc;font-family:'Inter',sans-serif;height:100%;\">\n  <style>\n    #hr-training-metrics-panel .dashboard-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n      gap: 1.5rem;\n      height: 100%;\n      max-width: 1400px;\n      margin: 0 auto;\n      padding: .2rem;\n    }\n\n    #hr-training-metrics-panel .card {\n      background: linear-gradient(145deg, #1f2937, #162029);\n      border-radius: 16px;\n      padding: 1rem 1.7rem;\n      border: 1px solid #334155;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;\n      cursor: default;\n      position: relative;\n      overflow: hidden;\n    }\n\n    #hr-training-metrics-panel .card::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      height: 4px;\n      background: linear-gradient(90deg, #3b82f6, #8b5cf6);\n      opacity: 0;\n      transition: opacity 0.3s ease;\n    }\n\n    #hr-training-metrics-panel .card:hover {\n      transform: translateY(-6px);\n      box-shadow: 6px 6px 12px rgba(0, 0, 0, 0.8),\n        -6px -6px 12px rgba(40, 50, 70, 0.9);\n      border-color: #475569;\n    }\n\n    #hr-training-metrics-panel .card:hover::before {\n      opacity: 1;\n    }\n\n    #hr-training-metrics-panel .card-title {\n      font-size: 1.15rem;\n      font-weight: 800;\n      margin-bottom: 1rem;\n      color: #e0e7ff;\n      text-transform: uppercase;\n      letter-spacing: 1.2px;\n      text-align: center;\n    }\n\n    #hr-training-metrics-panel .metric-value {\n      font-size: 2.1rem;\n      font-weight: 900;\n      margin-top: 0.5rem;\n      color: #f8fafc;\n      display: flex;\n      align-items: center;\n      gap: 0.6rem;\n      position: relative;\n    }\n\n    #hr-training-metrics-panel .metric-label {\n      font-size: 0.9rem;\n      font-weight: 600;\n      color: #94a3b8;\n      margin-top: 0.3rem;\n      letter-spacing: 0.05em;\n      text-align: center;\n    }\n\n    @keyframes pulse {\n      0%, 100% {\n        opacity: 1;\n        transform: translateY(0) scale(1);\n      }\n      50% {\n        opacity: 0.8;\n        transform: translateY(-4px) scale(1.05);\n      }\n    }\n\n    #hr-training-metrics-panel .icon {\n      display: inline-block;\n      user-select: none;\n      animation: pulse 2s infinite;\n    }\n\n    @media (max-width: 768px) {\n      #hr-training-metrics-panel .dashboard-grid {\n        grid-template-columns: 1fr;\n        max-width: 100%;\n      }\n    }\n  </style>\n\n  <div class=\"dashboard-grid\">\n    <!-- Total Training Hours Annual -->\n    <div class=\"card\" title=\"Total Training Hours Annual\">\n      <h2 class=\"card-title\">Total Training Hours</h2>\n      <div class=\"metric-value\">\n        {{#if (or Total_Training_Hours_Annual (eq Total_Training_Hours_Annual 0))}}{{Total_Training_Hours_Annual}} Hours{{else}}-{{/if}}\n        <span class=\"icon\" aria-label=\"Annual training hours\" style=\"color: #10b981; font-size: 1.8rem; line-height: 1;\">📚</span>\n      </div>\n      <div class=\"metric-label\">Total Annual Training Hours</div>\n    </div>\n\n    <!-- Training Hours Per Month -->\n    <div class=\"card\" title=\"Training Hours Per Month\">\n      <h2 class=\"card-title\">Monthly Training Hours</h2>\n      <div class=\"metric-value\">\n        {{#if (or Training_Hours_Per_Month (eq Training_Hours_Per_Month 0))}}{{Training_Hours_Per_Month}} Hours{{else}}-{{/if}}\n        <span class=\"icon\" aria-label=\"Monthly training hours\" style=\"color: #06b6d4; font-size: 1.8rem; line-height: 1;\">🕒</span>\n      </div>\n      <div class=\"metric-label\">Avg. Training Hours per Month</div>\n    </div>\n\n    <!-- Training Hours Per Day -->\n    <div class=\"card\" title=\"Training Hours Per Day\">\n      <h2 class=\"card-title\">Daily Training Hours</h2>\n      <div class=\"metric-value\">\n        {{#if (or Training_Hours_Per_Day (eq Training_Hours_Per_Day 0))}}{{Training_Hours_Per_Day}} Hours{{else}}-{{/if}}\n        <span class=\"icon\" aria-label=\"Daily training hours\" style=\"color: #f59e0b; font-size: 1.8rem; line-height: 1;\">📅</span>\n      </div>\n      <div class=\"metric-label\">Avg. Training Hours per Day</div>\n    </div>\n\n    <!-- Employees Covered Percentage -->\n    <div class=\"card\" title=\"Employees Covered Percentage\">\n      <h2 class=\"card-title\">Employees Covered</h2>\n      <div class=\"metric-value\">\n        {{#if (or Employees_Covered_Percentage (eq Employees_Covered_Percentage 0))}}{{Employees_Covered_Percentage}}%{{else}}-{{/if}}\n        <span class=\"icon\" aria-label=\"Employee coverage\" style=\"color: #8b5cf6; font-size: 1.8rem; line-height: 1;\">👥</span>\n      </div>\n      <div class=\"metric-label\">Percentage of Employees Covered</div>\n    </div>\n\n    <!-- Training Attendance Rate -->\n    <div class=\"card\" title=\"Training Attendance Rate\">\n      <h2 class=\"card-title\">Attendance Rate</h2>\n      <div class=\"metric-value\">\n        {{#if (or Training_Attendance_Rate (eq Training_Attendance_Rate 0))}}{{Training_Attendance_Rate}}%{{else}}-{{/if}}\n        <span class=\"icon\" aria-label=\"Attendance and participation\" style=\"color: #ef4444; font-size: 1.8rem; line-height: 1;\">📊</span>\n      </div>\n      <div class=\"metric-label\">Training Attendance Rate</div>\n    </div>\n\n    <!-- Training Satisfaction Rate -->\n    <div class=\"card\" title=\"Training Satisfaction Rate\">\n      <h2 class=\"card-title\">Satisfaction Rate</h2>\n      <div class=\"metric-value\">\n        {{#if (or Training_Satisfaction_Rate (eq Training_Satisfaction_Rate 0))}}{{Training_Satisfaction_Rate}}%{{else}}-{{/if}}\n        <span class=\"icon\" aria-label=\"Satisfaction and feedback\" style=\"color: #ec4899; font-size: 1.8rem; line-height: 1;\">👍</span>\n      </div>\n      <div class=\"metric-label\">Training Satisfaction Rate</div>\n    </div>\n  </div>\n</div>\n",

          "content": "<div id=\"hired-left-arrows-panel\"\n  style=\"background-color:transparent;color:#f8fafc;font-family:'Inter',sans-serif;height:100%;\">\n  <style>\n    #hired-left-arrows-panel .dashboard-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 1.5rem;\n      height: 100%;\n      max-width: 1300px;\n      margin: 0 auto;\n    }\n\n    #hired-left-arrows-panel .card {\n      background: linear-gradient(145deg, #1f2937, #162029);\n      border-radius: 16px;\n      padding: .8rem 1.7rem;\n      border: 1px solid #334155;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n      cursor: default;\n      position: relative;\n    }\n\n    #hired-left-arrows-panel .card:hover {\n      transform: translateY(-6px);\n      box-shadow: 6px 6px 12px rgba(0, 0, 0, 0.8),\n        -6px -6px 12px rgba(40, 50, 70, 0.9);\n    }\n\n    #hired-left-arrows-panel .card-title {\n      font-size: 1.15rem;\n      font-weight: 800;\n      margin-bottom: 1rem;\n      color: #e0e7ff;\n      justify-content: center text-transform: uppercase;\n      letter-spacing: 1.2px;\n    }\n\n    #hired-left-arrows-panel .metric-value {\n      font-size: 2.1rem;\n      font-weight: 900;\n      margin-top: 0.5rem;\n      color: #f8fafc;\n      display: flex;\n      align-items: center;\n      gap: 0.6rem;\n    }\n\n    #hired-left-arrows-panel .metric-label {\n      font-size: 0.9rem;\n      font-weight: 600;\n      color: #94a3b8;\n      margin-top: 0.3rem;\n      letter-spacing: 0.05em;\n      text-align: center;\n    }\n\n    @keyframes pulse {\n\n      0%,\n      100% {\n        opacity: 1;\n        transform: translateY(0);\n      }\n\n      50% {\n        opacity: 0.7;\n        transform: translateY(-4px);\n      }\n    }\n\n    @media (max-width: 768px) {\n      #hired-left-arrows-panel .dashboard-grid {\n        grid-template-columns: 1fr;\n        max-width: 100%;\n      }\n    }\n  </style>\n\n  <div class=\"dashboard-grid\">\n    <!-- Candidate Satisfaction Rate -->\n    <div class=\"card\" title=\"Candidate Satisfaction Rate\">\n      <h2 class=\"card-title\">Candidate Satisfaction Rate</h2>\n      <div class=\"metric-value\">\n        {{#if Candidate_Satisfaction}}{{Candidate_Satisfaction}}%{{else}}-{{/if}}\n        <span aria-label=\"Positive feedback\" style=\"\n          color: #10b981;\n          font-size: 1.8rem;\n          line-height: 1;\n          user-select: none;\n          animation: pulse 2s infinite;\n          display: inline-block;\n        \">&#128077;</span> <!-- Thumbs up emoji for candidate satisfaction -->\n      </div>\n      <div class=\"metric-label\">Candidate Satisfaction Rate</div>\n    </div>\n\n    <!-- Hiring Manager Satisfaction Rate -->\n    <div class=\"card\" title=\"Hiring Manager Satisfaction Rate\">\n      <h2 class=\"card-title\">Hiring Manager Satisfaction</h2>\n      <div class=\"metric-value\">\n        {{#if Hiring_Manager_Satisfaction}}{{Hiring_Manager_Satisfaction}}%{{else}}-{{/if}}\n        <span aria-label=\"Rating\" style=\"\n          color: #ef4444;\n          font-size: 1.8rem;\n          line-height: 1;\n          user-select: none;\n          animation: pulse 2s infinite;\n          display: inline-block;\n        \">&#11088;</span> <!-- Star emoji for hiring manager satisfaction -->\n      </div>\n      <div class=\"metric-label\">Hiring Manager Satisfaction Rate</div>\n    </div>\n\n    <!-- Quality of Hire (New KPI) -->\n    <div class=\"card\" title=\"Quality of Hire\">\n      <h2 class=\"card-title\">Quality of Hire</h2>\n      <div class=\"metric-value\">\n        {{#if (or prob_period (eq prob_period 0))}}{{prob_period}}%{{else}}-{{/if}} <span aria-label=\"Increase\" style=\"\n                  color: #10b981;\n                  font-size: 1.8rem;\n                  line-height: 1;\n                  user-select: none;\n                  animation: pulse 2s infinite;\n                  display: inline-block;\n                \">&#9650;</span>\n      </div>\n      <div class=\"metric-label\"> Quality of Hire (% of hires who left)</div>\n    </div>\n    <!-- days to hire-->\n    <div class=\"card\" title=\"Quality of Hire\">\n      <h2 class=\"card-title\">Time To Hire</h2>\n      <div class=\"metric-value\">\n        {{#if time_hire}}{{time_hire}} Days{{else}}-{{/if}}\n        <span aria-label=\"Time Indicator\" style=\"\n        color: #059669;\n        font-size: 1.8rem;\n        line-height: 1;\n        user-select: none;\n        animation: pulse 2s infinite;\n        display: inline-block;\n      \">\n        &#9201;\n      </span>\n      </div>\n      <div class=\"metric-label\">Days To Hire</div>\n    </div>\n  </div>",
